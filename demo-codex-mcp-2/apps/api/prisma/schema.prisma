generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Sale {
  id          Int      @id @default(autoincrement())
  date        DateTime
  customer    String
  product     String
  category    String
  channel     String
  amount      Float
  status      String   @default("Completada")
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([category])
  @@index([status])
}
